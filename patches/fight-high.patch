+void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param);
+void fight_exec_packet(uint32_t subch, uint32_t method, int noninc,
+                       const uint32_t *data, uint32_t count)
+{
+    for (uint32_t i = 0; i < count;) {
+        uint32_t consumed = 0;
+        if (i && !subch && count - i >= 2)
+            consumed = fight_bulk_words(method, noninc, data + i, count - i);
+        if (!consumed) {
+            nv2a_pb_exec_method(subch, method, data[i]);
+            consumed = 1;
+        }
+        if (!noninc) method += consumed * 4;
+        i += consumed;
+    }
+}
