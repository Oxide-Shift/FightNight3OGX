+/* Only these register windows accept a contiguous payload with no other
+ * state transitions. The caller bounds the span at the current DMA PUT. */
+static uint32_t fight_bulk_words(uint32_t method, int noninc, const uint32_t *data, uint32_t count)
+{
+    if (method >= 0x0b00 && method < 0x0c00) {
+        int program = method < 0x0b80;
+        uint32_t room = ((program ? 0x0b80u : 0x0c00u) - method) / 4;
+        if (!noninc && count > room) count = room;
+        extern void fight_vsh_upload(const uint32_t *, uint32_t, int);
+        fight_vsh_upload(data, count, program);
+    } else if (noninc && method == NV097_ARRAY_ELEMENT16) {
+        if (s_gpu.prim) {
+            uint32_t room = (NV_MAX_INDICES - s_gpu.idx_count) / 2;
+            uint32_t used = count < room ? count : room;
+            /* The two supported hosts and the Xbox are little endian. */
+            memcpy(s_gpu.idx + s_gpu.idx_count, data, used * sizeof *data);
+            s_gpu.idx_count += used * 2;
+        }
+    } else if (noninc && method == NV097_INLINE_ARRAY) {
+        if (s_gpu.prim) {
+            uint32_t room = NV_MAX_INLINE - s_gpu.inline_count;
+            uint32_t used = count < room ? count : room;
+            memcpy(s_gpu.inline_buf + s_gpu.inline_count, data, used * sizeof *data);
+            s_gpu.inline_count += used;
+        }
+    } else return 0;
+    return count;
+}
