+/* The upload cursor is shared with the scalar path, including split packets. */
+void fight_vsh_upload(const uint32_t *data, uint32_t count, int program)
+{
+    uint32_t *slot = program ? &s_load_slot : &s_const_load;
+    uint32_t *component = program ? &s_load_word : &s_const_word;
+    uint32_t limit = program ? NV2A_VSH_SLOTS : NV2A_VSH_CONSTANTS;
+    if (*slot >= limit || count > (limit - *slot) * 4 - *component) {
+        for (uint32_t i = 0; i < count; i++) {
+            if (program) nv2a_vsh_program_word(data[i]);
+            else nv2a_vsh_constant_word(data[i]);
+        }
+        return;
+    }
+    unsigned char *base = program ? (unsigned char *)s_program : (unsigned char *)s_const;
+    unsigned char *dst = base + (*slot * 4 + *component) * sizeof(uint32_t);
+    size_t bytes = count * sizeof(uint32_t);
+    if (!program || memcmp(dst, data, bytes)) {
+        if (program) {
+            mark_instruction(*slot);
+            mark_instruction(*slot + (*component + count - 1) / 4);
+            s_dirty = 1;
+        }
+        memcpy(dst, data, bytes);
+    }
+    *slot += (*component + count) / 4;
+    *component = (*component + count) % 4;
 }
 
