+/* The loaded title's XBE certificate region (host_main sets RECOMP_TITLE_REGION). A European-only title
+ * (region 4) checks the factory AV region and returns to the dashboard unless the console is PAL. */
+int fight_pal_title(void)
+{
+    static int pal = -1;
+    if (pal < 0) {
+        const char *region = getenv("RECOMP_TITLE_REGION");
+        unsigned long value = region ? strtoul(region, NULL, 0) : 1;
+        pal = (value & 4u) && !(value & 1u);
+    }
+    return pal;
+}
