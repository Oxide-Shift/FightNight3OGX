+/* Fight Night often draws adjacent mesh groups with exactly the same depth,
+ * stencil, blend constant and culling state. These commands persist until
+ * another draw changes them. Other rendering passes reset the cache. */
+static void fight_raster_state(VkrContext *c, const VkrDrawState *st)
+{
+    uint32_t key[19] = {st->depth_test, st->depth_write, st->depth_func,
+        st->stencil_test, st->stencil_func, st->stencil_ref,
+        st->stencil_read_mask, st->stencil_write_mask, st->stencil_fail,
+        st->stencil_zfail, st->stencil_zpass, fight_cull_enable,
+        fight_cull_face, fight_front_face, (uint32_t)c->has_stencil};
+    memcpy(key + 15, st->blend_color, sizeof st->blend_color);
+    if (c->fight_state_valid && !memcmp(key, c->fight_raster, sizeof key)) return;
+    memcpy(c->fight_raster, key, sizeof key);
+    c->fight_state_valid = 1;
+    vkCmdSetDepthTestEnable(c->cmd, st->depth_test ? VK_TRUE : VK_FALSE);
+    vkCmdSetDepthWriteEnable(c->cmd, st->depth_write ? VK_TRUE : VK_FALSE);
+    vkCmdSetDepthCompareOp(c->cmd, st->depth_func >= 0x200 && st->depth_func <= 0x207
+                                       ? (VkCompareOp)(st->depth_func - 0x200)
+                                       : VK_COMPARE_OP_LESS_OR_EQUAL);
+    set_stencil(c, st);
+    vkCmdSetBlendConstants(c->cmd, st->blend_color);
+    fight_apply_cull(c->cmd);
+}
