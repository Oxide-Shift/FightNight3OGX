+/* The retail GetExitCodeThread immediately reads SignalState and ExitStatus,
+ * then releases the reference in the same guest frame. A snapshot is valid
+ * for this caller only. Other object consumers can require a live dispatcher
+ * object with a different lifetime and layout. */
+static RECOMP_TLS uint32_t s_exit_snapshot;
+
+static uint32_t bridge_reference_exit_snapshot(uint32_t token, uint32_t output)
+{
+    const uint32_t index = token & BRIDGE_HANDLE_MASK;
+    DWORD code = 259u;
+    if (!bridge_va_mapped(output, 4)) return 0xC0000005u;
+    BRIDGE_MEM32(output) = 0;
+    if (s_exit_snapshot) return 0xC0000001u;
+    if (token != 0xFFFFFFFEu) {
+        if ((token & ~BRIDGE_HANDLE_MASK) != BRIDGE_HANDLE_TAG ||
+            !index || index >= BRIDGE_HANDLE_MAX) return 0xC0000008u;
+        bridge_lock_handles();
+        HANDLE h = s_handle_table[index];
+        BOOL valid = h == (HANDLE)(intptr_t)-2 ||
+                     (h && h != INVALID_HANDLE_VALUE && GetExitCodeThread(h, &code));
+        bridge_unlock_handles();
+        if (!valid) return 0xC0000008u;
+    }
+    uint32_t object = xbox_HeapAlloc(0x124u, 16);
+    if (!object) return 0xC000009Au;
+    BRIDGE_MEM32(object + 4) = code != 259u;
+    BRIDGE_MEM32(object + 0x120) = (uint32_t)code;
+    s_exit_snapshot = object;
+    BRIDGE_MEM32(output) = object;
+    return 0;
+}
