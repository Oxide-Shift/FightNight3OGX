+/* The private build tool reads a draw count followed by the pipeline key.
+   Periodic writes keep captured states even if the game host exits abruptly. */
+static void save_fragment_profile(VkrContext *c)
+{
+    for (int i = 0; i < c->npipes; i++) {
+        struct PipeEntry *entry = c->pipes[i];
+        if (!entry->profile_draws)
+            continue;
+        uint32_t record[1 + sizeof entry->key / sizeof(uint32_t)];
+        record[0] = entry->profile_draws;
+        memcpy(record + 1, entry->key, sizeof entry->key);
+        fwrite(record, sizeof record, 1, c->fight_fragment_profile);
+        entry->profile_draws = 0;
+    }
+    fflush(c->fight_fragment_profile);
+}
+
 void vkr_destroy(VkrContext *c)
 {
     if (!c) return;
+    if (c->fight_fragment_profile) {
+        save_fragment_profile(c);
+        fclose(c->fight_fragment_profile);
+    }
     free_target(c);
     vkDeviceWaitIdle(c->dev);
     tex_free_all(c);
