+/* A general TD describes at most two 4K pages. The second can precede
+ * the first in physical memory (including for a 20-byte XID report). */
+static unsigned td_length(uint32_t cbp, uint32_t end)
+{
+    if (!cbp) return 0;
+    if (((cbp ^ end) >> 12) == 0) return end >= cbp ? end - cbp + 1 : 0;
+    return (0x1000u - (cbp & 0xfffu)) + (end & 0xfffu) + 1u;
+}
+
+static uint32_t td_advance(uint32_t cbp, uint32_t end, unsigned bytes)
+{
+    unsigned first = 0x1000u - (cbp & 0xfffu);
+    return bytes < first ? cbp + bytes : (end & ~0xfffu) + bytes - first;
+}
+
+static int td_copy(uint32_t cbp, uint32_t end, uint8_t *data, unsigned bytes, int to_guest)
+{
+    unsigned first = 0x1000u - (cbp & 0xfffu);
+    if (first > bytes) first = bytes;
+    uint8_t *a = guest_ptr(cbp, first);
+    uint8_t *b = bytes > first ? guest_ptr(end & ~0xfffu, bytes - first) : NULL;
+    if (!a || (bytes > first && !b)) return 0;
+    if (to_guest) {
+        memcpy(a, data, first);
+        if (b) memcpy(b, data + first, bytes - first);
+    } else {
+        memcpy(data, a, first);
+        if (b) memcpy(data + first, b, bytes - first);
+    }
+    return 1;
+}
