+/* Remove an old content key while preserving every collision chain. */
+static void fight_rekey(VkrContext *c,VkrTex *t,uint64_t key) {
+    if(!c->hcap){t->key=key;tex_rehash(c);return;}
+    unsigned mask=c->hcap-1, hole=tex_slot(t->key,c->hcap);
+    while(c->hidx[hole]>=0 && c->texs[c->hidx[hole]]!=t)hole=(hole+1)&mask;
+    if(c->hidx[hole]<0){t->key=key;tex_rehash(c);return;}
+    int index=c->hidx[hole];
+    for(unsigned scan=(hole+1)&mask;c->hidx[scan]>=0;scan=(scan+1)&mask){
+        unsigned home=tex_slot(c->texs[c->hidx[scan]]->key,c->hcap);
+        if(((hole-home)&mask)<((scan-home)&mask)){
+            c->hidx[hole]=c->hidx[scan];hole=scan;
+        }
+    }
+    c->hidx[hole]=-1;t->key=key;
+    unsigned at=tex_slot(key,c->hcap);
+    while(c->hidx[at]>=0)at=(at+1)&mask;
+    c->hidx[at]=index;
 }
 
