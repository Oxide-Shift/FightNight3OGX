+/* Borrow a tightly pitched linear surface directly. Swizzled colour targets
+ * are unswizzled into one reusable upload scratch by the submission thread. */
+const uint32_t *fight_color_pixels(int stage) {
+    const Texture *t=&s_gpu.texs[stage];
+    if(!t->valid || t->cube || !t->width || !t->height || (t->offset&3))return NULL;
+    if(t->color!=0x06 && t->color!=0x12)return NULL;
+    size_t bytes=(size_t)t->width*t->height*4;
+    if(bytes>64u*1024*1024 || (uint64_t)(t->offset&0x0fffffffu)+bytes>g_xbox_total_ram)return NULL;
+    const uint32_t *source=(const uint32_t *)XBOX_HOST(t->offset);
+    if(t->color==0x12)return t->pitch==t->width*4 ? source : NULL;
+    if(t->width<4 || t->height<2 || t->width>4096 ||
+       (t->width & (t->width-1)) || (t->height & (t->height-1)))return NULL;
+    static size_t capacity;
+    static uint32_t *scratch;
+    if(capacity<bytes){
+        uint32_t *more=realloc(scratch,bytes);
+        if(!more)return NULL;
+        scratch=more;capacity=bytes;
+    }
+    fight_unpack_argb(source,scratch,t->width,t->height);
+    return scratch;
+}
