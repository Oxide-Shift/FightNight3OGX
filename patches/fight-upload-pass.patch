 /* Submit what has been recorded and wait for it. Texture uploads are in
  * there: dropping the commands left those textures without content, and
  * they stayed cached that way (magenta HUD in races after a resize). */
+static VkResult fight_submit_frame(VkrContext *c) {
+    VkrFrame *frame = &c->fr[c->cur];
+    VkCommandBuffer buffers[2] = {frame->uploads, c->cmd};
+    VkSubmitInfo submit = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    if (frame->uploading) {
+        VkResult result = vkEndCommandBuffer(frame->uploads);
+        if (result != VK_SUCCESS) return result;
+        frame->uploading = 0;
+        submit.commandBufferCount = 2;
+        submit.pCommandBuffers = buffers;
+    } else {
+        submit.commandBufferCount = 1;
+        submit.pCommandBuffers = &buffers[1];
+    }
+    return vkQueueSubmit(c->queue, 1, &submit, c->fence);
+}
