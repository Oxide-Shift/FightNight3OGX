 /* New contents for an existing texture of the same size (a render target
  * the title redraws every frame: its shadow maps). Draws recorded before
  * this still read the old contents -- the copy is ordered after them. */
+static VkCommandBuffer fight_upload_cmd(VkrContext *c, int independent) {
+    VkrFrame *frame = &c->fr[c->cur];
+    if (independent) {
+        if (frame->uploading) return frame->uploads;
+        VkCommandBufferBeginInfo begin = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        if (vkResetCommandBuffer(frame->uploads, 0) == VK_SUCCESS &&
+            vkBeginCommandBuffer(frame->uploads, &begin) == VK_SUCCESS) {
+            frame->uploading = 1;
+            return frame->uploads;
+        }
+    }
+    end_pass(c);
+    return c->cmd;
+}
